# Private signing inputs; never share real keys or include .env in an audit package.
# Use one signing source. MNEMONIC takes priority if both are set.
PRIVATE_KEY=
MNEMONIC=

# Initial owner, Endpoint delegate and home-chain constructor supply recipient.
# Set explicitly on EVERY chain. It must be your verified operational multisig.
ADMIN=

# Optional overrides: uncomment and provide a nonempty value only when needed.
# RPC_URL_BSC=https://your-reviewed-bsc-rpc
# RPC_URL_BSC_TESTNET=https://your-reviewed-bsc-testnet-rpc
# LZ_ENDPOINT=0xYourVerifiedOfficialLocalEndpoint
